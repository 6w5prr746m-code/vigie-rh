# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais commiter .env.

# Base de données (SQLite local ; pour Postgres : postgresql://user:pass@host:5432/vigie)
DATABASE_URL="file:./dev.db"

# France Travail — application créée sur francetravail.io avec l'API « Offres d'emploi v2 »
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Anthropic — classification des actualités (sans clé : classement par mots-clés)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Flux RSS additionnels (presse RH, régionale…), séparés par des virgules ; les articles citant un compte surveillé sont rattachés
NEWS_FEEDS=
