# Copier ce fichier en .env puis renseigner les valeurs. Ne jamais commiter .env.

# Base de données (SQLite local ; pour Postgres : postgresql://user:pass@host:5432/vigie)
DATABASE_URL="file:./dev.db"

# HubSpot — Private App (étape 3)
HUBSPOT_TOKEN=

# INSEE — API Sirene (étape 4), clé d'API du portail portail-api.insee.fr
INSEE_API_KEY=

# France Travail — Offres d'emploi v2 (étape 4), application créée sur francetravail.io
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# Anthropic — classification des actualités (étape 4)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
